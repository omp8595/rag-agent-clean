# ─── LLM ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# ─── Chroma ────────────────────────────────────────────
# Leave blank to use in-memory (local dev)
# Set to http://localhost:8000 when running Chroma server
CHROMA_URL=

# ─── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── RAG settings ──────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=8
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
